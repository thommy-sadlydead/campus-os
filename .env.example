# Copy this file to .env and fill in real values before running the app.

# Postgres connection string. For a Vercel deploy, the Prisma Postgres or
# Neon marketplace integration sets this for you automatically — see the
# README's "Deploying to Vercel" section. For local runs, point it at that
# same database, or any other Postgres you have.
DATABASE_URL=""

# Used to sign session tokens and encrypt any stored tokens (Gmail OAuth
# tokens, Canvas access tokens). Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Sign-up is invite-only. New accounts must enter this code, so share it
# only with people you invite; change it to stop further sign-ups with the
# old one. Leave it empty to close sign-up entirely (existing accounts can
# still log in). Generate one with:
#   openssl rand -hex 8
SIGNUP_INVITE_CODE=""

# Optional. Shown on the public /privacy page as the address for questions
# and data requests. Google's OAuth verification expects one.
CONTACT_EMAIL=""

# Optional but required for AI-backed features (dashboard "why this task"
# explanations, the per-class and cross-app assistants, and — for Gmail —
# actually extracting structured facts like a moved exam date; without a
# key, Email Intelligence still filters/categorizes/tags emails by class,
# it just won't propose schedule changes on its own). Every AI-backed
# feature falls back to deterministic, non-AI behavior instead of failing,
# except lecture notes (see ASSEMBLYAI_API_KEY below).
ANTHROPIC_API_KEY=""
# Optional — defaults to a current Claude Sonnet model. See
# https://docs.claude.com/en/docs/about-claude/models for available IDs.
ANTHROPIC_MODEL=""

# Optional — most people don't need these. Once you're logged in, the
# in-app Connect page (/connect) links Canvas, Schoology, Brightspace or
# Blackboard with no .env editing at all. These two are only for Canvas's
# command-line alternative (`npm run canvas:sync`), useful if you want to
# run the sync from a cron job instead of clicking a button.
# Generate a token in Canvas: Account -> Settings -> New Access Token.
CANVAS_BASE_URL="https://cedarville.instructure.com"
CANVAS_ACCESS_TOKEN=""

# The App Store review account(s): comma-separated emails. Signed in as
# one of these, the dashboard (when empty) and the Account page offer "Add
# sample classes", made-up classes so a reviewer without a school login can
# try everything (src/lib/sample-classes.ts). Nobody else sees it.
DEMO_ACCOUNT_EMAILS=""

# Local testing only; both are ignored in production. Point the Schoology
# client at a stand-in server, and let calendar feed links and the Canvas
# address be localhost (src/lib/lms/safe-fetch.ts normally refuses them).
# Put them in .env.development.local, never in Vercel.
# SCHOOLOGY_API_URL="http://localhost:4100/schoology/v1"
# LMS_ALLOW_LOCAL_URLS="1"

# Gmail integration (Email page). From a Google Cloud OAuth client you
# create yourself at https://console.cloud.google.com/apis/credentials:
#   1. Create a project (or reuse one) -> APIs & Services -> Credentials.
#   2. Enable the "Gmail API" under APIs & Services -> Library.
#   3. Create an OAuth client ID (type: Web application). Add
#      GOOGLE_REDIRECT_URI below as an "Authorized redirect URI".
#   4. While the OAuth consent screen is in "Testing" mode, add your own
#      Google account under "Test users" or Google will refuse to log you in.
# Only the read-only gmail.readonly scope is ever requested — this app can
# never send, delete, or modify anything in your inbox, and your password
# never touches it (Google's own OAuth screen handles sign-in).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/email/oauth/callback"

# Required for the Lectures tab (per-class audio upload -> transcript -> AI
# notes). This has no deterministic fallback — transcribing
# audio isn't something a heuristic can do — so without a key an uploaded
# lecture just goes to FAILED with a clear "not configured" message instead
# of a degraded result. Get a key at https://www.assemblyai.com/app/account.
ASSEMBLYAI_API_KEY=""

# Also required for the Lectures tab — stores the uploaded lecture audio.
# Created automatically once you connect a Blob store to this project in the
# Vercel dashboard (Storage tab -> Create Database -> Blob); for local dev,
# either copy the token from there or run `vercel env pull` after linking
# the project with `vercel link`.
BLOB_READ_WRITE_TOKEN=""

# Payments (src/lib/billing.ts). Off until PAYMENTS_ENABLED=1: then sign-up
# no longer needs an invite code, new accounts get a free trial, and an
# account whose trial has ended must subscribe (or redeem a free-access
# code) to keep using the app. Turn it on only once Stripe and App Store
# Connect below are set up.
PAYMENTS_ENABLED=""
# Free for good: one or more codes, comma-separated, case-insensitive.
# Redeemed on the website under Account. Change it to stop new people from
# using an old code; accounts that already redeemed it stay free.
FREE_ACCESS_CODE=""
# Optional: this site's public address for Stripe's return links, if it
# can't be worked out from the request (it normally can).
APP_URL=""

# Stripe, for subscriptions bought on the website (https://dashboard.stripe.com):
#   1. Product catalog: one product with two recurring prices, monthly and
#      yearly. Copy each price's ID (price_...) below.
#   2. Developers -> API keys: the secret key (sk_test_... while testing).
#   3. Developers -> Webhooks: add an endpoint at
#      https://<your site>/api/stripe/webhook listening for
#      checkout.session.completed and customer.subscription.created /
#      .updated / .deleted. Copy its signing secret (whsec_...).
#   4. Settings -> Billing -> Customer portal: save it once (Stripe won't
#      open the portal until you do), allowing plan switches and cancels.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
