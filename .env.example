# Copy this file to .env and fill in real values before running the app.

# SQLite by default — zero setup for local/self-hosted use. For a
# serverless deploy (Vercel, etc.) point this at a hosted Postgres
# instead and change the `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Used to sign session tokens and encrypt any stored OAuth tokens
# (phase 4 / Gmail integration). Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional but required for AI-backed features (dashboard "why this task"
# explanations, the assignment-breakdown estimator, per-class assistant,
# behind/at-risk narrative). Without it those features fall back to
# deterministic, non-AI behavior instead of failing.
ANTHROPIC_API_KEY=""
# Optional — defaults to a current Claude Sonnet model. See
# https://docs.claude.com/en/docs/about-claude/models for available IDs.
ANTHROPIC_MODEL=""

# Required for `npm run canvas:sync` to pull your real courses/assignments.
# Generate a token in Canvas: Account -> Settings -> New Access Token.
CANVAS_BASE_URL="https://cedarville.instructure.com"
CANVAS_ACCESS_TOKEN=""

# Phase 4 (Gmail): from a Google Cloud OAuth client you create yourself at
# https://console.cloud.google.com/apis/credentials — not set up yet.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/email/oauth/callback"
