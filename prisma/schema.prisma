// Campus OS data model.
//
// Design notes (see README for the full rationale):
// - Postgres (deployed on Vercel, via the Prisma Postgres marketplace
//   integration or Neon) — DATABASE_URL points at it both in production
//   and for any local run, so there's one real database, not a local
//   SQLite copy that drifts from what's actually deployed. (This project
//   started on SQLite for zero-config local dev; see git history / the
//   README's Roadmap for that migration.)
// - Canvas stays the source of truth for classes/assignments/exams
//   (canvasCourseId / canvasAssignmentId let sync be idempotent — re-running
//   it updates existing rows instead of duplicating them).
// - Email never writes directly into Class/Assignment/Exam. It always goes
//   through PendingChange so a human confirms anything ambiguous or
//   conflicting (see lib/email-intelligence.ts in phase 4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())

  sessions            Session[]
  classes             Class[]
  availabilityBlocks  AvailabilityBlock[]
  emailAccount        EmailAccount?
  canvasAccount       CanvasAccount?
  emails              Email[]
  pendingChanges      PendingChange[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Class {
  id             String   @id @default(cuid())
  userId         String
  code           String // e.g. "ECON-2330-03"
  name           String // e.g. "Microeconomics"
  professor      String?
  room           String?
  color          Int      @default(1) // 1-8, maps to the course.N palette
  canvasCourseId String?  @unique
  currentGrade   String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]
  assignments    Assignment[]
  exams          Exam[]
  noteSections   NoteSection[]
  resources      Resource[]
  lectures       Lecture[]
  emails         Email[]
  pendingChanges PendingChange[]

  @@index([userId])
}

// A recurring weekly meeting pattern ("MWF 9:00-9:50am, Bio Hall 210").
// Cancellations/room changes for a specific occurrence are handled as
// PendingChange records referencing this event, not by mutating history.
model ScheduleEvent {
  id          String  @id @default(cuid())
  classId     String
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes after midnight, local class time
  endMinute   Int
  location    String?
  label       String? // "Lecture", "Lab", "Discussion"

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// SQLite has no native enum type (Prisma's `enum` keyword only works on
// connectors that do — Postgres/MySQL). This is a plain String instead,
// constrained at the application layer to "NOT_STARTED" | "IN_PROGRESS" |
// "SUBMITTED" | "GRADED" (see WorkStatus in src/lib/priority-engine.ts).
// Swapping to Postgres for a real deploy, this could become a true enum
// again with one line changed here.
model Assignment {
  id                 String    @id @default(cuid())
  classId            String
  canvasAssignmentId String?   @unique
  name               String
  description        String? // full assignment text, when Canvas/email provides it
  dueAt              DateTime?
  pointsPossible     Float?
  status             String    @default("NOT_STARTED")
  estimatedMinutes   Int? // rolled up from tasks once broken down, or a direct estimate
  sourceEmailId      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  class       Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  sourceEmail Email? @relation(fields: [sourceEmailId], references: [id])
  tasks       Task[]

  @@index([classId])
  @@index([dueAt])
}

// Subtask produced by the automatic assignment breakdown (phase 3), or
// added manually. Ordered within its assignment.
model Task {
  id               String    @id @default(cuid())
  assignmentId     String
  title            String
  estimatedMinutes Int?
  order            Int       @default(0)
  completed        Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model Exam {
  id                 String   @id @default(cuid())
  classId            String
  canvasAssignmentId String?  @unique
  name               String
  examAt             DateTime?
  location           String?
  weight             Float?
  notes              String?
  createdAt          DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([examAt])
}

// ---------------------------------------------------------------------------
// Notes & resources
// ---------------------------------------------------------------------------

model NoteSection {
  id        String   @id @default(cuid())
  classId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  class Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([classId])
}

model Note {
  id            String   @id @default(cuid())
  sectionId     String
  title         String
  bodyMarkdown  String   @default("")
  pinned        Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  section NoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model Resource {
  id      String   @id @default(cuid())
  classId String
  title   String
  type    String // "link" | "file" | "document"
  url     String?
  notes   String?
  addedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// A recorded lecture: an uploaded audio file, its AssemblyAI transcript, and
// AI-generated notes from that transcript. Like Voicewrite, this has no
// deterministic fallback — transcription and note generation ARE the
// feature, so without ASSEMBLYAI_API_KEY/ANTHROPIC_API_KEY configured (or on
// a transient failure) a lecture just sits in FAILED with errorMessage set,
// same as Voicewrite's "not configured" error instead of a degraded answer.
//
// status is a String, not a Prisma enum — see the note above Assignment.status.
// Application-level values: "UPLOADED" | "TRANSCRIBING" | "GENERATING_NOTES" |
// "READY" | "FAILED" (see LectureStatus in src/lib/lecture-notes.ts).
model Lecture {
  id               String    @id @default(cuid())
  classId          String
  title            String
  audioUrl         String // Vercel Blob URL (direct client-side upload)
  status           String    @default("UPLOADED")
  assemblyaiId     String? // transcript id at AssemblyAI, used to poll status
  transcriptText   String?
  notesMarkdown    String?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// ---------------------------------------------------------------------------
// Canvas connection (in-app "Connect Canvas")
// ---------------------------------------------------------------------------

// One linked Canvas account per user. Unlike Gmail, Canvas doesn't offer a
// student-facing OAuth flow — this stores a personal access token the user
// generates themselves (Canvas: Account -> Settings -> New Access Token),
// encrypted at rest the same way Gmail's tokens are (src/lib/crypto.ts).
// baseUrl is stored per-user (not just the CANVAS_BASE_URL env var) so this
// still works correctly if a user ever attends a different school.
model CanvasAccount {
  id             String    @id @default(cuid())
  userId         String    @unique
  baseUrl        String
  accessTokenEnc String
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Email intelligence (phase 4)
// ---------------------------------------------------------------------------

// One linked mailbox per user. Tokens are encrypted at rest (see
// lib/crypto.ts) and only a read-only Gmail scope is ever requested.
model EmailAccount {
  id               String    @id @default(cuid())
  userId           String    @unique
  provider         String    @default("google")
  emailAddress     String
  accessTokenEnc   String
  refreshTokenEnc  String
  expiresAt        DateTime?
  scope            String?
  connectedAt      DateTime  @default(now())
  lastSyncedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// String, not a Prisma enum — see the note above Assignment.status.
// Application-level values: "ASSIGNMENT" | "EXAM" | "SCHEDULE_CHANGE" |
// "ANNOUNCEMENT" | "SYLLABUS" | "OTHER_ACADEMIC" | "IRRELEVANT" |
// "UNCLASSIFIED" (see EmailCategory in src/lib/email-classify-heuristic.ts).
model Email {
  id             String   @id @default(cuid())
  userId         String
  classId        String?
  gmailMessageId String   @unique
  fromAddress    String
  fromName       String?
  subject        String
  snippet        String?
  bodyText       String?
  receivedAt     DateTime
  category       String   @default("UNCLASSIFIED")
  extractedJson  String? // raw structured extraction from the AI pass
  confidence     Float?
  reviewed       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  class              Class?          @relation(fields: [classId], references: [id])
  assignmentsSourced Assignment[]
  pendingChanges     PendingChange[]

  @@index([userId])
  @@index([classId])
}

// The conflict-resolution queue: email intelligence NEVER writes directly
// into Class/ScheduleEvent/Assignment/Exam. It proposes a change here, and
// only a user decision (or an unambiguous new-value-with-no-existing-value
// case) applies it.
//
// `status` is a String, not a Prisma enum — see the note above
// Assignment.status. Application-level values: "PENDING" | "ACCEPTED" |
// "REJECTED" (see src/lib/change-rules.ts / src/lib/pending-changes.ts).
model PendingChange {
  id            String    @id @default(cuid())
  userId        String
  classId       String?
  sourceEmailId String?
  entityType    String // "Exam" | "Assignment" | "ScheduleEvent" | "Class"
  entityId      String? // null when the change would create a new record
  field         String // e.g. "examAt", "room"
  oldValueText  String?
  newValueText  String?
  reason        String? // short human-readable explanation of what triggered this
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class? @relation(fields: [classId], references: [id])
  sourceEmail Email? @relation(fields: [sourceEmailId], references: [id])

  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Time & workload
// ---------------------------------------------------------------------------

// Explicit, user-entered free time. The dashboard/workload engine must
// NEVER estimate or fabricate this — if there are no blocks for a day, it
// says so instead of guessing.
model AvailabilityBlock {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // date-only (stored at UTC midnight for that local day)
  startMinute Int
  endMinute   Int
  label       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
