// Campus OS data model.
//
// Design notes (see README for the full rationale):
// - Postgres (deployed on Vercel, via the Prisma Postgres marketplace
//   integration or Neon) — DATABASE_URL points at it both in production
//   and for any local run, so there's one real database, not a local
//   SQLite copy that drifts from what's actually deployed. (This project
//   started on SQLite for zero-config local dev; see git history / the
//   README's Roadmap for that migration.)
// - The student's LMS (Canvas, Schoology, D2L Brightspace or Blackboard)
//   stays the source of truth for classes/assignments/exams. lmsCourseId /
//   lmsItemId let sync be idempotent — re-running it updates existing rows
//   instead of duplicating them. They're unique per account, never
//   globally: classmates share the same course and assignment ids.
// - Schema changes that `prisma db push` can't make on its own without
//   --accept-data-loss (a unique index on a table that has rows) go in
//   prisma/pre-push.sql, which the build runs first (see CLAUDE.md).
// - Email never writes directly into Class/Assignment/Exam. It always goes
//   through PendingChange so a human confirms anything ambiguous or
//   conflicting (see lib/email-intelligence.ts in phase 4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())
  // When the student allowed AI features: sending the text, emails and
  // recordings each one needs to Anthropic and AssemblyAI. Null means
  // they haven't (or turned it off), and nothing is sent; see
  // src/lib/ai-consent.ts. Required by App Store guideline 5.1.2(i).
  aiConsentAt  DateTime?
  // Which optional features the student turned on (src/lib/features.ts),
  // as feature ids. featuresChosenAt is null until they pick (at sign-up or
  // under Account → Features): until then an account made before the
  // picker existed keeps every feature it had (LEGACY_FEATURES).
  features         String[]  @default([])
  featuresChosenAt DateTime?
  // The latest an exam prep session may end, in minutes after midnight
  // (local time). Null means the default, 10 PM (DEFAULT_STUDY_CUTOFF).
  studyCutoffMinute Int?
  // Payments (src/lib/billing.ts), enforced only when PAYMENTS_ENABLED=1.
  // trialEndsAt: end of the free trial; set at sign-up, or on the first
  // visit after payments went live for accounts made before. Null means
  // not started yet. freeAccessAt: when the account redeemed
  // FREE_ACCESS_CODE, which makes it free for good.
  trialEndsAt       DateTime?
  freeAccessAt      DateTime?
  // StoreKit's appAccountToken: a UUID the iPhone app attaches to every
  // purchase, so an Apple subscription can only ever unlock this account.
  // Indexed, not @unique: adding a unique constraint to the existing User
  // table makes `prisma db push` stop for confirmation, which fails the
  // Vercel build. A random UUID and Stripe's customer ID don't collide.
  appleAccountToken String?
  stripeCustomerId  String?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  classes             Class[]
  availabilityBlocks  AvailabilityBlock[]
  emailAccount        EmailAccount?
  canvasAccount       CanvasAccount?
  lmsConnections      LmsConnection[]
  emails              Email[]
  pendingChanges      PendingChange[]
  oauthGrants         OAuthGrant[]
  calendarFeed        CalendarFeed?
  commitments         Commitment[]
  studySessions       StudySession[]
  extensionPairings   ExtensionPairing[]
  extensionTokens     ExtensionToken[]
  schoolRequests      SchoolAccessRequest[]

  @@index([appleAccountToken])
  @@index([stripeCustomerId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Forgot password?" links (src/app/forgot-password). Only an HMAC of the
// token is stored, like Session.tokenHash, so the database alone can't be
// used to reset anyone's password. A link works once (usedAt) and for an
// hour (expiresAt); see src/lib/password-reset.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Class {
  id             String   @id @default(cuid())
  userId         String
  code           String // e.g. "ECON-2330-03"
  name           String // e.g. "Microeconomics"
  professor      String?
  room           String?
  color          Int      @default(1) // 1-8, maps to the course.N palette
  // Where the class was synced from: "canvas" | "schoology" | "brightspace"
  // | "blackboard" (LmsProvider in src/lib/lms/providers.ts). Null for a
  // class added by hand.
  lmsProvider    String?
  // The course's id in that LMS (a Schoology section id, or a course key
  // from a calendar feed). Unique per account and provider, not globally:
  // when it was globally unique, a classmate's sync took over the first
  // student's class instead of making their own. The column keeps its
  // Canvas-era name.
  lmsCourseId    String?  @map("canvasCourseId")
  currentGrade   String?
  // Grades (src/lib/grades.ts). gradePercent is the course's current
  // score: from Canvas when it shows students their total, or read from
  // what the student typed into currentGrade. gradeSource: "canvas" |
  // "manual". gradeTarget is the student's goal, for the final-exam
  // calculator and "below your goal" warnings.
  gradePercent   Float?
  gradeLetter    String?
  gradeSource    String?
  gradeUpdatedAt DateTime?
  gradeTarget    Float?
  // Get help (src/lib/get-help.ts): typed in, or found in the syllabus.
  professorEmail String?
  officeHours    String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleEvents ScheduleEvent[]
  assignments    Assignment[]
  exams          Exam[]
  noteSections   NoteSection[]
  resources      Resource[]
  lectures       Lecture[]
  materials      ClassMaterial[]
  emails         Email[]
  pendingChanges PendingChange[]
  syncState      MaterialSyncState?
  flashcardDecks FlashcardDeck[]
  gradeSnapshots GradeSnapshot[]
  studySessions  StudySession[]

  @@unique([userId, lmsProvider, lmsCourseId])
  @@index([userId])
}

// A recurring weekly meeting pattern ("MWF 9:00-9:50am, Bio Hall 210").
// Cancellations/room changes for a specific occurrence are handled as
// PendingChange records referencing this event, not by mutating history.
model ScheduleEvent {
  id          String  @id @default(cuid())
  classId     String
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes after midnight, local class time
  endMinute   Int
  location    String?
  label       String? // "Lecture", "Lab", "Discussion"
  // The semester's first and last day for this meeting ("2026-08-25", a
  // calendar date in the student's time zone; see src/lib/meetings.ts).
  // Null: it repeats every week with no start or end.
  startsOn    String?
  endsOn      String?
  createdAt   DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// A student's class meetings as a calendar subscription, at
// /calendar/<token>.ics, that Apple, Google or Outlook Calendar refreshes
// on its own (src/lib/calendar-feed-server.ts). The link is the only key,
// so it's a secret: tokenHash (hashToken, like Session) finds it, and
// tokenEnc (encryptSecret) lets the Schedule page show it again. Resetting
// the link replaces both, and the old link stops working.
model CalendarFeed {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  tokenEnc  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// SQLite has no native enum type (Prisma's `enum` keyword only works on
// connectors that do — Postgres/MySQL). This is a plain String instead,
// constrained at the application layer to "NOT_STARTED" | "IN_PROGRESS" |
// "SUBMITTED" | "GRADED" (see WorkStatus in src/lib/priority-engine.ts).
// Swapping to Postgres for a real deploy, this could become a true enum
// again with one line changed here.
//
// lmsSubmission is what the LMS last said about this student's own
// submission: "unsubmitted" | "submitted" | "graded" (LmsSubmission in
// src/lib/lms/status.ts), or null when it doesn't say (calendar feeds,
// assignments added by hand, and rows synced before it was recorded).
model Assignment {
  id                 String    @id @default(cuid())
  classId            String
  // The item's id in the class's LMS (a Canvas assignment, a Schoology
  // grade item, a calendar feed event's UID). Unique per class; the column
  // keeps its Canvas-era name.
  lmsItemId          String?   @map("canvasAssignmentId")
  // The item's own page in the LMS, when it gave one ("Open in Canvas").
  lmsUrl             String?
  lmsSubmission      String?
  name               String
  description        String? // full assignment text, when Canvas/email provides it
  dueAt              DateTime?
  pointsPossible     Float?
  status             String    @default("NOT_STARTED")
  estimatedMinutes   Int? // rolled up from tasks once broken down, or a direct estimate
  sourceEmailId      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  class       Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  sourceEmail Email? @relation(fields: [sourceEmailId], references: [id])
  tasks       Task[]

  @@unique([classId, lmsItemId])
  @@index([classId])
  @@index([dueAt])
}

// Subtask produced by the automatic assignment breakdown (phase 3), or
// added manually. Ordered within its assignment.
model Task {
  id               String    @id @default(cuid())
  assignmentId     String
  title            String
  estimatedMinutes Int?
  order            Int       @default(0)
  completed        Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

// lmsItemId: the LMS item the exam came from. The same id as its
// Assignment when the exam is one (most are), or a calendar event's id
// ("event:…") when the LMS only lists it on the calendar. Null for an
// exam added by hand or from an email.
model Exam {
  id                 String   @id @default(cuid())
  classId            String
  lmsItemId          String?  @map("canvasAssignmentId")
  lmsUrl             String?
  name               String
  examAt             DateTime?
  location           String?
  weight             Float?
  notes              String?
  createdAt          DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  studySessions StudySession[]

  @@unique([classId, lmsItemId])
  @@index([classId])
  @@index([examAt])
}

// ---------------------------------------------------------------------------
// Notes & resources
// ---------------------------------------------------------------------------

model NoteSection {
  id        String   @id @default(cuid())
  classId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  class Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([classId])
}

// lectureId is set on the note that holds a lecture's generated notes (see
// src/lib/lecture-notes-sync.ts). That one note is what both the Notes tab
// and the Lectures tab show, so an edit in either place shows up in both.
// Deleting the lecture keeps the note (SetNull). There's deliberately no
// unique constraint: adding one makes `prisma db push` stop for a
// data-loss prompt, which fails the non-interactive build. One note per
// lecture is enforced in lecture-notes-sync.ts instead.
model Note {
  id            String   @id @default(cuid())
  sectionId     String
  title         String
  bodyMarkdown  String   @default("")
  pinned        Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lectureId     String?

  section NoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lecture Lecture?    @relation(fields: [lectureId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@index([lectureId])
}

model Resource {
  id      String   @id @default(cuid())
  classId String
  title   String
  type    String // "link" | "file" | "document"
  url     String?
  notes   String?
  addedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// Class-level reference material (textbook excerpts, slide content) that
// gets folded into the prompt every time notes are generated for any
// lecture in this class — the class's persistent "memory" for note
// generation, independent of any one lecture's transcript. content is
// either pasted directly or fetched once from sourceUrl at add-time (see
// addClassMaterialFromUrlAction) — a link is never re-fetched afterward, so
// content is always what's actually being used, even if the page changes or
// disappears later. No file upload/parsing yet — see src/lib/lecture-notes.ts.
//
// type is a String, not a Prisma enum — see the note above Assignment.status.
// Application-level values: "BOOK" | "SLIDES" | "SYLLABUS" | "NOTES" (see
// MaterialType in src/lib/canvas-materials.ts).
// provider/resourceType/syncStatus are Strings, not Prisma enums — see the
// note above Assignment.status. Application-level values:
// provider: "canvas" | "schoology" | null (manually added via paste/link/upload)
// resourceType: "file" | "page" | "syllabus" | "external" (see ResourceType in src/lib/canvas-materials.ts)
// syncStatus: "READY" | "FAILED" | "EXTERNAL" | "SKIPPED_TOO_LARGE" |
// "SKIPPED_UNSUPPORTED" | "SKIPPED_NOISE" | "MISSING" (see
// src/lib/canvas-materials-sync.ts)
model ClassMaterial {
  id        String   @id @default(cuid())
  classId   String
  type      String
  title     String
  content   String
  sourceUrl String? // where content was fetched from, if added as a link — display/reference only, never re-fetched
  createdAt DateTime @default(now())

  // LMS sync tracking — all null for materials added manually (paste,
  // link, or file upload). See src/lib/canvas-materials-sync.ts. The two
  // columns keep their Canvas-era names.
  provider         String?
  lmsResourceId    String?   @map("canvasResourceId") // the LMS's file id for file-backed resources, or a synthetic stable id for others (see canvas-materials.ts)
  resourceType     String?
  lmsUpdatedAt     DateTime? @map("canvasUpdatedAt") // the LMS's own last-modified time, used to detect changed resources on re-sync
  lastSyncedAt     DateTime?
  syncStatus       String?
  syncError        String?

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Dedup key for synced materials: the same file referenced via both
  // Files and Modules resolves to the same lmsResourceId, so it's only
  // ever imported once. NULL is distinct from NULL in a Postgres unique
  // index, so manually-added materials (lmsResourceId always null) never
  // collide with each other or with synced ones.
  @@unique([classId, provider, lmsResourceId])
  @@index([classId])
}

// One row per class tracking its most-recent-or-in-flight materials sync
// (Canvas or Schoology). Drives per-course progress in the UI and makes the
// sync resumable: if processing is interrupted mid-course, the next poll
// picks the same course back up from its persisted resourcesDone count
// instead of restarting or silently losing progress. See
// src/lib/canvas-materials-sync.ts. The table keeps its Canvas-era name.
//
// status is a String, not a Prisma enum — see the note above
// Assignment.status. Application-level values: "PENDING" | "DISCOVERING" |
// "DOWNLOADING" | "READY" | "PARTIAL" | "FAILED".
model MaterialSyncState {
  id              String    @id @default(cuid())
  classId         String    @unique
  status          String    @default("PENDING")
  resourcesFound  Int       @default(0)
  resourcesDone   Int       @default(0)
  resourcesFailed Int       @default(0)
  // Files the Chrome extension still has to send this run (Brightspace,
  // Blackboard; src/lib/lms/extension-import.ts). Null for Canvas and
  // Schoology, whose server-side sync tracks its own progress.
  resourcesPending Int?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("CanvasSyncCourseState")
}

// A recorded lecture: an uploaded audio file (or a directly pasted
// transcript — see below), its AssemblyAI transcript, and AI-generated notes
// from that transcript. This has no deterministic fallback —
// transcription and note generation ARE the feature, so without
// ASSEMBLYAI_API_KEY/ANTHROPIC_API_KEY configured (or on a transient
// failure) a lecture just sits in FAILED with errorMessage set instead of
// a degraded answer.
//
// status is a String, not a Prisma enum — see the note above Assignment.status.
// Application-level values: "UPLOADED" | "TRANSCRIBING" | "GENERATING_NOTES" |
// "READY" | "FAILED" (see LectureStatus in src/lib/lecture-notes.ts).
model Lecture {
  id               String    @id @default(cuid())
  classId          String
  title            String
  audioUrl         String? // Vercel Blob URL (direct client-side upload) — null for a pasted-transcript lecture, which skips audio/AssemblyAI entirely
  status           String    @default("UPLOADED")
  assemblyaiId     String? // transcript id at AssemblyAI, used to poll status
  transcriptText   String?
  notesMarkdown    String? // the generated notes as first written; the linked Note (below) is the copy the student edits
  errorMessage     String?
  // When the notes were first copied into the Notes tab. Stays set if the
  // student later deletes that note, so it isn't quietly added back.
  noteSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([classId])
}

// ---------------------------------------------------------------------------
// LMS connections (the Connect page: Canvas, Schoology, Brightspace, Blackboard)
// ---------------------------------------------------------------------------

// One linked Canvas account per user. Unlike Gmail, Canvas doesn't offer a
// student-facing OAuth flow — this stores a personal access token the user
// generates themselves (Canvas: Account -> Settings -> New Access Token),
// encrypted at rest the same way Gmail's tokens are (src/lib/crypto.ts).
// baseUrl is stored per-user (not just the CANVAS_BASE_URL env var) so this
// still works correctly if a user ever attends a different school.
// lastSyncReport: JSON, what the last sync found (SyncReport in
// src/lib/lms/report.ts).
model CanvasAccount {
  id             String    @id @default(cuid())
  userId         String    @unique
  baseUrl        String
  accessTokenEnc String
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?
  lastSyncReport String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A connection to Schoology, D2L Brightspace or Blackboard (Canvas keeps
// its own CanvasAccount, above). One per provider per account.
//   provider: "schoology" | "brightspace" | "blackboard"
//   baseUrl: the school's address in that LMS, for links and display.
//   credentialsEnc: JSON, encrypted with src/lib/crypto.ts. Schoology: the
//     student's own API key and secret (from <school>.schoology.com/api).
//     Brightspace/Blackboard: calendar feed links, which carry their own
//     access token, so they're secrets too. Neither LMS lets a student
//     use its API without the school registering the app first.
//   settings: JSON, per-provider (Schoology: the account's user id and
//     time zone; calendar feeds: course names and skipped courses).
//   lastSyncReport: JSON, what the last sync found (SyncReport in
//     src/lib/lms/report.ts).
// See src/lib/lms/ for each provider.
model LmsConnection {
  id             String    @id @default(cuid())
  userId         String
  provider       String
  baseUrl        String
  credentialsEnc String
  settings       String?
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?
  lastSyncReport String?
  // How it connects: null for the API key (Schoology) or calendar link
  // (Brightspace, Blackboard) in credentialsEnc; "extension" for the Campus
  // OS Chrome extension (src/lib/lms/extension-import.ts), which syncs from
  // the student's own browser. baseUrl is then the LMS site's origin, and
  // credentialsEnc holds nothing secret.
  method         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// No longer written (November 2026): the "Ask your school" email it counted
// was replaced by the Chrome extension (src/lib/lms/extension-import.ts).
// Kept so the requests students already made aren't dropped; they go with
// the account when it's deleted.
model SchoolAccessRequest {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  schoolHost   String
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, schoolHost])
}

// ---------------------------------------------------------------------------
// Email intelligence (phase 4)
// ---------------------------------------------------------------------------

// One linked mailbox per user. Tokens are encrypted at rest (see
// lib/crypto.ts) and only a read-only Gmail scope is ever requested.
model EmailAccount {
  id               String    @id @default(cuid())
  userId           String    @unique
  provider         String    @default("google")
  emailAddress     String
  accessTokenEnc   String
  refreshTokenEnc  String
  expiresAt        DateTime?
  scope            String?
  connectedAt      DateTime  @default(now())
  lastSyncedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// String, not a Prisma enum — see the note above Assignment.status.
// Application-level values: "ASSIGNMENT" | "EXAM" | "SCHEDULE_CHANGE" |
// "ANNOUNCEMENT" | "SYLLABUS" | "OTHER_ACADEMIC" | "IRRELEVANT" |
// "UNCLASSIFIED" (see EmailCategory in src/lib/email-classify-heuristic.ts).
model Email {
  id             String   @id @default(cuid())
  userId         String
  classId        String?
  gmailMessageId String   @unique
  fromAddress    String
  fromName       String?
  subject        String
  snippet        String?
  bodyText       String?
  receivedAt     DateTime
  category       String   @default("UNCLASSIFIED")
  extractedJson  String? // raw structured extraction from the AI pass
  confidence     Float?
  reviewed       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  class              Class?          @relation(fields: [classId], references: [id])
  assignmentsSourced Assignment[]
  pendingChanges     PendingChange[]

  @@index([userId])
  @@index([classId])
}

// The conflict-resolution queue: email intelligence NEVER writes directly
// into Class/ScheduleEvent/Assignment/Exam. It proposes a change here, and
// only a user decision (or an unambiguous new-value-with-no-existing-value
// case) applies it.
//
// `status` is a String, not a Prisma enum — see the note above
// Assignment.status. Application-level values: "PENDING" | "ACCEPTED" |
// "REJECTED" (see src/lib/change-rules.ts / src/lib/pending-changes.ts).
model PendingChange {
  id            String    @id @default(cuid())
  userId        String
  classId       String?
  sourceEmailId String?
  entityType    String // "Exam" | "Assignment" | "ScheduleEvent" | "Class"
  entityId      String? // null when the change would create a new record
  field         String // e.g. "examAt", "room"
  oldValueText  String?
  newValueText  String?
  reason        String? // short human-readable explanation of what triggered this
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class? @relation(fields: [classId], references: [id])
  sourceEmail Email? @relation(fields: [sourceEmailId], references: [id])

  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Time & workload
// ---------------------------------------------------------------------------

// Explicit, user-entered free time. The dashboard/workload engine must
// NEVER estimate or fabricate this — if there are no blocks for a day, it
// says so instead of guessing.
model AvailabilityBlock {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // date-only (stored at UTC midnight for that local day)
  startMinute Int
  endMinute   Int
  label       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// One row per rate-limited event: a failed login, an AI request, a new
// lecture. src/lib/rate-limit.ts counts rows per key over a sliding window
// and prunes anything older than a day. `key` is a plain string rather than
// a User relation because failed logins are keyed by the attempted email,
// which may not belong to anyone. Examples: "login-email:a@school.edu",
// "login-ip:203.0.113.7", "ai:<userId>", "lecture:<userId>".
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A paid subscription, bought on the website (Stripe) or in the iPhone app
// (Apple). One row per Stripe subscription or Apple original transaction,
// kept current by their webhooks (src/app/api/stripe/webhook,
// src/app/api/apple/notifications).
//   source: "stripe" | "apple"
//   plan:   "monthly" | "yearly"
//   status: "active" | "past_due" | "canceled" | "expired"
// It unlocks the app while status is active or past_due and
// currentPeriodEnd hasn't passed (accessFor in src/lib/billing.ts).
model Subscription {
  id                String   @id @default(cuid())
  userId            String
  source            String
  externalId        String
  plan              String
  status            String
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// "Sign in with Campus OS" for ChatGPT (src/lib/oauth/, src/app/mcp)
// ---------------------------------------------------------------------------

// One app's access to one account, made when the student taps Allow on
// /oauth/authorize. clientId is the app's client metadata document URL
// (ChatGPT's is https://chatgpt.com/oauth/client.json); resource is the MCP
// endpoint the tokens were minted for. Disconnecting sets revokedAt, which
// stops every token of the grant at once.
model OAuthGrant {
  id         String    @id @default(cuid())
  userId     String
  clientId   String
  clientName String
  scope      String
  resource   String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  codes  OAuthCode[]
  tokens OAuthToken[]

  @@index([userId])
}

// An authorization code: single use (usedAt), ten minutes (expiresAt), and
// only for the redirect URI and PKCE challenge it was issued with. Only an
// HMAC is stored, like Session.tokenHash.
model OAuthCode {
  id            String    @id @default(cuid())
  grantId       String
  codeHash      String    @unique
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

// Access and refresh tokens, stored as HMACs. kind: "access" | "refresh".
// A refresh token works once: using it sets usedAt and issues a new pair,
// and presenting a used one again revokes the grant (a stolen token).
model OAuthToken {
  id        String    @id @default(cuid())
  grantId   String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

// ---------------------------------------------------------------------------
// Study tab (src/app/classes/[id]/study-actions.ts, src/lib/flashcards.ts)
// ---------------------------------------------------------------------------

// A set of flashcards the AI made from a class's notes, lecture notes and
// course files. source says what it was made from, for the deck list.
model FlashcardDeck {
  id        String   @id @default(cuid())
  classId   String
  title     String
  source    String
  createdAt DateTime @default(now())

  class Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  cards Flashcard[]
  studySessions StudySession[]

  @@index([classId])
}

// known: marked "Got it" while studying; Start over clears it.
model Flashcard {
  id     String  @id @default(cuid())
  deckId String
  front  String
  back   String
  order  Int
  known  Boolean @default(false)
  // Spaced review (src/lib/spaced-review.ts): box is how many times in a
  // row the student got it right (0 = new or just missed), dueAt when it
  // should come back. Null dueAt means it's never been studied (new).
  box        Int       @default(0)
  dueAt      DateTime?
  reviewedAt DateTime?

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
}

// ---------------------------------------------------------------------------
// Grades, exam prep and commitments (src/lib/grades.ts, exam-prep.ts)
// ---------------------------------------------------------------------------

// A class's grade each time it changed, so the dashboard can tell when
// it's slipping (gradeSlip in src/lib/grades.ts).
model GradeSnapshot {
  id      String   @id @default(cuid())
  classId String
  percent Float
  takenAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, takenAt])
}

// Something outside class that takes up time every week: a work shift,
// practice, a club. One row per weekday, like ScheduleEvent, with the same
// optional first and last day ("2026-08-25"). Exam prep plans avoid these.
model Commitment {
  id          String   @id @default(cuid())
  userId      String
  label       String
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int
  endMinute   Int
  startsOn    String?
  endsOn      String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One session of an exam prep plan (src/lib/exam-prep.ts): a short self-
// quiz before an exam, usually on the plan's flashcard deck.
// status: "PLANNED" | "DONE" | "SKIPPED".
model StudySession {
  id          String    @id @default(cuid())
  userId      String
  classId     String
  examId      String
  deckId      String?
  startsAt    DateTime
  minutes     Int
  status      String    @default("PLANNED")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  exam  Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  deck  FlashcardDeck? @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([examId])
}

// ---------------------------------------------------------------------------
// The Campus OS Chrome extension for Brightspace and Blackboard
// (chrome-extension/, src/lib/lms/extension-*.ts)
// ---------------------------------------------------------------------------

// A one-time code a Connect page hands the extension to pair it with the
// signed-in account. Stored as an HMAC (hashToken), good for 10 minutes.
model ExtensionPairing {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// What the paired extension signs its requests with. Stored as an HMAC;
// deleting the row (disconnecting) is what revokes it.
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A piece of a course file the extension is uploading, when the file is
// bigger than one request (Vercel caps requests at 4.5 MB). Deleted once
// the file is put together and read; leftovers from an upload that never
// finished are cleared after an hour.
model ExtensionUploadPart {
  id        String   @id @default(cuid())
  userId    String
  uploadId  String
  part      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([uploadId, part])
  @@index([createdAt])
}
