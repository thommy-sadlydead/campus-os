{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "campus-os": {
      "type": "streamable-http",
      "url": "https://campus-os-mocha-pi.vercel.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["campus.read"]
          }
        }
      }
    }
  }
}
