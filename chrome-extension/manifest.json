{
  "manifest_version": 3,
  "name": "Campus OS Connector",
  "short_name": "Campus OS",
  "version": "1.0.1",
  "description": "Imports your Brightspace and Blackboard courses, due dates and course files into Campus OS, using the sign-in you already have.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Campus OS",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://campus-os-mocha-pi.vercel.app/*", "https://app.campus-os.net/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    { "matches": ["https://campus-os-mocha-pi.vercel.app/*", "https://app.campus-os.net/*"], "js": ["src/app-bridge.js"], "run_at": "document_idle" }
  ]
}
